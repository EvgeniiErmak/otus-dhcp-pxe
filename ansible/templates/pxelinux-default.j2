# {{ ansible_managed }}
SERIAL 0 115200
DEFAULT install
LABEL install
  KERNEL linux
  INITRD initrd
  APPEND root=/dev/ram0 ramdisk_size=5000000 ip=:::::enp0s3:dhcp iso-url=http://{{ pxe_ip }}/srv/images/{{ iso_file }} autoinstall ds=nocloud-net;s=http://{{ pxe_ip }}/srv/ks/ console=tty0 console=ttyS0,115200n8
